# Neon Postgres connection string (free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/profixsai?sslmode=require

# Long random string used to sign session tokens
JWT_SECRET=change-this-to-a-long-random-string

# Cookie is marked Secure in production; set to "false" only for local http dev
COOKIE_SECURE=true
